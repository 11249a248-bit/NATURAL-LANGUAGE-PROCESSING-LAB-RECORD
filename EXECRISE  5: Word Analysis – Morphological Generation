def morph_generate(root, tag):
    if tag == '+PLURAL':
        if root.endswith('y'):
            return root[:-1] + 'ies'
        elif root.endswith(('s', 'x', 'ch', 'sh')):
            return root + 'es'
        return root + 's'

    elif tag == '+PROG':
        return root + 'ing'

    elif tag == '+PAST':
        return root + 'ed'

    return root

pairs = [('cat', '+PLURAL'),
         ('fly', '+PLURAL'),
         ('box', '+PLURAL'),
         ('play', '+PROG'),
         ('jump', '+PAST')]

for root, tag in pairs:
    print(root, tag, "->", morph_generate(root, tag))
